FROM ghcr.io/cross-rs/aarch64-unknown-linux-gnu:edge

ENV DEBIAN_FRONTEND=noninteractive

RUN dpkg --add-architecture arm64 && \
    apt-get update && \
    apt-get install -y --no-install-recommends aptitude clang libclang-dev pkg-config && \
    apt-get clean && \
    aptitude install -d -y \
    libopencv-dev:arm64 \
    libgstreamer1.0-dev:arm64 \
    libgstreamer-plugins-base1.0-dev:arm64 \
    libssl-dev:arm64 && \
    dpkg --unpack --force-all /var/cache/apt/archives/*.deb || true && \
    find /usr/lib/aarch64-linux-gnu -path "*/blas/libblas.so.3" -exec ln -sf {} /usr/lib/aarch64-linux-gnu/libblas.so.3 \; && \
    find /usr/lib/aarch64-linux-gnu -path "*/lapack/liblapack.so.3" -exec ln -sf {} /usr/lib/aarch64-linux-gnu/liblapack.so.3 \; && \
    find /usr/lib/aarch64-linux-gnu -path "*/openblas*/libblas.so.3" -exec ln -sf {} /usr/lib/aarch64-linux-gnu/libblas.so.3 \; && \
    find /usr/lib/aarch64-linux-gnu -path "*/openblas*/liblapack.so.3" -exec ln -sf {} /usr/lib/aarch64-linux-gnu/liblapack.so.3 \;

ENV BINDGEN_EXTRA_CLANG_ARGS="-isystem /usr/aarch64-linux-gnu/include -isystem /usr/include/aarch64-linux-gnu"
